# Gemini API Key (Google AI Studio: https://aistudio.google.com/apikey)
# Needed ONLY when generating TTS audio (~0.80 - 1.00 EUR per hour of lessons in batch mode).
# The app works out of the box in silent preview mode even without a key!
GEMINI_API_KEY=

# Optional hard safety ceiling for TTS batch runs (in EUR)
TTS_MAX_BUDGET_EUR=5.00
